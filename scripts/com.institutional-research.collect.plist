<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.institutional-research.collect.plist — the stopgap archiver's real schedule.

  WHY THIS EXISTS ALONGSIDE CRON, RATHER THAN AS A TIDIER VERSION OF IT.

  cron does NOT replay a job missed while the Mac was asleep or shut down. It
  fires only if the machine happens to be awake at the instant. launchd's
  StartCalendarInterval DOES: a missed interval runs when the machine next wakes.

  That difference is not theoretical. Measured from logs/collect_2026-08.log:

      2026-08-17 20:50   manual
      2026-08-18 08:00
      2026-08-18 22:30
      2026-08-20 22:30   <- Aug 19 missing ENTIRELY

  Aug 19 was a Wednesday trading session. All three cron slots missed it, and the
  20:00 slot has never fired once. Because nseindia's historical endpoint answers
  503, that session's bulk and block deals are gone permanently — not
  inconvenient to recover, gone.

  Plan 3 Phase 2.9 specified launchd from day one. The implementation used cron,
  and this is the day that cost a session.

  CRON WAS DELIBERATELY LEFT IN PLACE, AND THEN RETIRED (decision 0059,
  2026-09-15). The trade was correct while the script only archived: sha256
  dedupe made a duplicate run a free HTTP request. It stopped being correct
  when land -> identity -> mart -> outcomes and the spine rebuild joined the
  script (0055): those take DuckDB's exclusive write lock, and two runs
  starting seconds apart collided every slot. This file is now the ONLY
  trigger. Install / reload with:
      cp scripts/com.institutional-research.collect.plist ~/Library/LaunchAgents/
      launchctl bootout gui/$UID/com.institutional-research.collect
      launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.institutional-research.collect.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.institutional-research.collect</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/satya_03/Workspace/institutional-research/scripts/collect_daily.sh</string>
    </array>

    <!--
      THREE slots per session, every calendar day (owner request 2026-09-17,
      decision 0072 — reverses 0060's two-slot schedule, which was itself the
      owner's own request on 2026-09-15). 0060 is not wrong to have existed;
      this is a second owner decision, not a correction of the first.

      20:30 — same-day file. NSE publishes around 19:00 IST and does not
              republish; 20:30 leaves headroom for an on-time publish.
      22:30 — same-day catch-up. Measured (0068): a same-day hit rises from
              ~82% at 20:30 to ~93% by 22:30 for a late NSE publish. This is
              the slot 0060 removed; putting it back trades a little more
              runtime for a meaningfully higher same-day capture rate on the
              two rolling feeds that cannot be re-fetched once tomorrow's file
              replaces today's.
      08:30 — catch-up. At 08:30 the endpoint is STILL serving the prior
              session, so a missed or failed evening is recovered here, not
              repeated. sha256 dedupe makes a redundant morning run a no-op.

      Every day INCLUDING Sat/Sun: a Friday evening miss is caught Saturday
      08:30; a weekend run finds nothing new and costs one HTTP request.

      Weekday: 0=Sunday .. 6=Saturday (man launchd.plist: "0 and 7 are
      Sunday"). 21 intervals: 7 days x 3 slots.
    -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>

        <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>

        <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>30</integer></dict>
    </array>

    <!--
      The script writes its own timestamped log. These capture anything that dies
      BEFORE the script's own redirection takes effect — a missing interpreter, a
      bad path, a permissions refusal. Without them that class of failure is
      invisible, which is the same "looks like a covered day" failure the script's
      own header warns about.
    -->
    <key>StandardOutPath</key>
    <string>/Users/satya_03/Workspace/institutional-research/logs/launchd_collect.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/satya_03/Workspace/institutional-research/logs/launchd_collect.err</string>

    <key>WorkingDirectory</key>
    <string>/Users/satya_03/Workspace/institutional-research</string>

    <!-- Do not fire on load: loading is not a session boundary. -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
