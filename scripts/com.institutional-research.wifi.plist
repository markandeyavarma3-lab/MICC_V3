<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.institutional-research.wifi.plist — keep the KL University Wi-Fi signed in.

  WHY (2026-09-25). The campus Sophos portal keeps a session only while
  something sends its keep-alive; its own login page does that every 180
  seconds, and with no browser tab open nothing does, so the Mac was dropped
  after about ten idle minutes and every fetch after that failed DNS. This
  job sends the same keep-alive on the same 180-second cadence, and signs in
  again (src/common/portal.py) whenever the portal has let the session lapse.

  StartInterval, not KeepAlive: one short request every three minutes, then
  exit. launchd does not run it while the Mac sleeps; a collector run that
  wakes the Mac signs in on its own (src/common/network.py, wait_and_recover).

  Credentials are NOT here and NOT in the repository: ~/.micc_wifi_portal,
  mode 600, created with `python -m src.common.portal --setup`.

  Install / reload:
      cp scripts/com.institutional-research.wifi.plist ~/Library/LaunchAgents/
      launchctl bootout   gui/$UID/com.institutional-research.wifi 2>/dev/null
      launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.institutional-research.wifi.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.institutional-research.wifi</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/satya_03/Workspace/institutional-research/.venv/bin/python</string>
        <string>-m</string>
        <string>src.common.portal</string>
        <string>--keepalive</string>
    </array>

    <key>StartInterval</key>
    <integer>180</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/satya_03/Workspace/institutional-research/logs/wifi_keepalive.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/satya_03/Workspace/institutional-research/logs/wifi_keepalive.err</string>

    <key>WorkingDirectory</key>
    <string>/Users/satya_03/Workspace/institutional-research</string>
</dict>
</plist>
