<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.institutional-research.shp.plist — the nightly shareholding-pattern sweep.

  18:45 every day (decision 0078), between the 18:30 and 21:00 collector runs,
  inside the evening window the owner keeps the laptop on. The 130-minute wall
  clock ends it by 20:55, so the sweep's ~1 request/2s never stacks on the
  21:00 collector's.

  Install / reload:
      cp scripts/com.institutional-research.shp.plist ~/Library/LaunchAgents/
      launchctl bootout   gui/$UID/com.institutional-research.shp 2>/dev/null
      launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.institutional-research.shp.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.institutional-research.shp</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/satya_03/Workspace/institutional-research/scripts/shp_nightly.sh</string>
    </array>
    <!--
      18:45 DAILY (decision 0078, 2026-09-28): inside the evening window the
      owner keeps the laptop on, after the 18:30 collector and ending by 20:55
      (a 130-minute wall clock) before the 21:00 one. Replaces 01:00 / 10:30 / 14:30,
      which mostly found the Mac asleep or offline.
    -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>45</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/satya_03/Workspace/institutional-research/logs/launchd_shp.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/satya_03/Workspace/institutional-research/logs/launchd_shp.err</string>
    <key>WorkingDirectory</key>
    <string>/Users/satya_03/Workspace/institutional-research</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
